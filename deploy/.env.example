# Replace both references with the digests from the successful release workflow summary.
GOTO_API_IMAGE=ghcr.io/deway-developpement/goto-api@sha256:REPLACE_WITH_API_DIGEST
GOTO_WEB_IMAGE=ghcr.io/deway-developpement/goto-web@sha256:REPLACE_WITH_WEB_DIGEST
CADDY_NETWORK=caddy
GOTO_DATABASE_NETWORK=goto-database
GOTO_API_DATA_VOLUME=goto-api-data
# Keep this file on the server, outside Git. Use api/.env.example as the key list.
GOTO_API_ENV_FILE=/etc/goto/api.env
