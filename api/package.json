{
    "name": "goto_api",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "NODE_ENV=development nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "NODE_ENV=production node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "typeorm": "ts-node ./node_modules/typeorm/cli",
        "typeorm:run-migrations": "npm run typeorm migration:run -- -d ./src/ormconfig.ts",
        "typeorm:generate-migration": "npm run typeorm -- -d ./src/ormconfig.ts migration:generate ./migrations/$npm_config_name",
        "typeorm:create-migration": "npm run typeorm -- migration:create ./migrations/$npm_config_name",
        "typeorm:revert-migration": "npm run typeorm -- -d ./src/ormconfig.ts migration:revert"
    },
    "dependencies": {
        "@apollo/server": "^5.5.1",
        "@as-integrations/express5": "^1.1.2",
        "@escape.tech/graphql-armor": "^3.2.0",
        "@graphql-tools/utils": "^11.2.2",
        "@nestjs/apollo": "^13.4.5",
        "@nestjs/common": "^11.2.3",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.2.3",
        "@nestjs/graphql": "^13.4.5",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.2.3",
        "@nestjs/typeorm": "^11.0.3",
        "@ptc-org/nestjs-query-core": "^10.0.3",
        "@ptc-org/nestjs-query-graphql": "^10.0.3",
        "@ptc-org/nestjs-query-typeorm": "^10.0.3",
        "@xmldom/xmldom": "^0.9.12",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "dataloader": "^2.2.2",
        "graphql": "^16.14.2",
        "graphql-subscriptions": "^3.0.0",
        "graphql-upload": "15.0.2",
        "joi": "^17.6.0",
        "mysql2": "^3.24.4",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.0",
        "passport-local": "^1.0.0",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.1.3",
        "rxjs": "^7.2.0",
        "snowflake-uuid": "^1.0.0",
        "typeorm": "^0.3.12"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.2.3",
        "@types/express": "^4.17.13",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.20.2",
        "@types/passport-jwt": "^3.0.6",
        "@types/passport-local": "^1.0.34",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "eslint": "^8.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "jest": "^29.7.0",
        "prettier": "^3.6.2",
        "source-map-support": "^0.5.20",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.12",
        "ts-loader": "^9.2.3",
        "ts-node": "^10.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
